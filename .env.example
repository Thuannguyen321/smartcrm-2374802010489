# Sao chep: cp .env.example .env   (Windows PowerShell: copy .env.example .env)
# KHONG commit file .env. Cac gia tri duoi day la gia tri MAU, chay duoc ngay de thu;
# khi trien khai that phai doi DB_PASSWORD va JWT_SECRET.

# --- Docker Compose ---
# Cong mo ra may chu de vao he thong (http://localhost:3000). Cong 3000 bi chiem thi doi so khac.
APP_PORT=3000
# Ten CSDL, tai khoan va mat khau PostgreSQL (container db tao khi volume con trong)
DB_NAME=smartcrm_db
DB_USER=smartcrm
# Chi dung chu va so (mat khau duoc ghep vao chuoi ket noi)
DB_PASSWORD=smartcrm_dev

# --- Ung dung ---
# Khoa ky JWT - doi thanh chuoi ngau nhien >= 32 ky tu (openssl rand -hex 32).
# Giu nguyen gia tri mau thi server KHONG dung no ma sinh khoa tam thoi (dang nhap lai sau moi lan khoi dong) - BUG-06
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
# Thoi han token dang nhap
JWT_EXPIRES_IN=8h
# Nguon frontend duoc phep goi API khi chay giao dien rieng bang Vite (npm run client:dev)
CORS_ORIGIN=http://localhost:5173

# --- Chi dung khi chay bang Node tren may (khong qua Docker) ---
# Trong Docker, docker-compose.yml tu ghep DATABASE_URL tu DB_USER/DB_PASSWORD/DB_NAME voi host "db".
DATABASE_URL=postgres://smartcrm:smartcrm_dev@localhost:5432/smartcrm_db
# Cong cua backend khi chay bang Node tren may
PORT=3000
