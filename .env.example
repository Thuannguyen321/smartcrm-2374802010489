# Sao chep thanh .env roi sua gia tri. KHONG commit file .env.
# Chuoi ket noi PostgreSQL 16 (khop voi docker-compose.yml neu chay CSDL bang Docker)
DATABASE_URL=postgres://smartcrm:smartcrm_dev@localhost:5432/smartcrm_db
# Cong cua backend API
PORT=3000
# Khoa ky JWT - doi thanh chuoi ngau nhien dai >= 32 ky tu
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
# Thoi han token dang nhap
JWT_EXPIRES_IN=8h
# Nguon frontend duoc phep goi API (Vite dev server)
CORS_ORIGIN=http://localhost:5173
